# next@16.3 preview builds don't satisfy peer ranges like "^16.0.0" (npm semver
# treats prereleases as outside normal ranges), which makes plain `npm install`
# hard-fail on @mui/material-nextjs — locally AND on Vercel. This relaxes peer
# resolution the way npm <7 behaved. Remove once we're back on a stable Next.
legacy-peer-deps=true
